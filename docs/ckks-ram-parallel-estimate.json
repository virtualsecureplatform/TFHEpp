    "instrumentation_forest_source": "template<std::size_t Level=0,class Chain>\nvoid diagnosticForest(std::vector<Narrow::TreeResult>&results,\n std::vector<std::vector<CKKSCiphertext<P,Narrow::factor_log_q-Level*Narrow::log_delta,Narrow::log_delta>>> factors,\n const Chain&chain){\n if constexpr(Level==Narrow::tree_depth){results.resize(factors.size());for(size_t t=0;t<factors.size();++t)results[t]=std::move(factors[t][0]);}\n else{\n using Next=CKKSCiphertext<P,Narrow::factor_log_q-(Level+1)*Narrow::log_delta,Narrow::log_delta>;\n std::vector<std::vector<Next>> next(factors.size());std::vector<std::pair<size_t,size_t>> pairs;\n for(size_t t=0;t<factors.size();++t){next[t].resize(factors[t].size()/2);for(size_t i=0;i<next[t].size();++i)pairs.emplace_back(t,i);}\n std::vector<double> seconds(pairs.size());auto start=std::chrono::steady_clock::now();\n #pragma omp parallel for schedule(dynamic,1) num_threads(8)\n for(size_t j=0;j<pairs.size();++j){auto [t,i]=pairs[j];auto then=std::chrono::steady_clock::now();CKKSMultRelinThenRescale<P>(next[t][i],factors[t][2*i],factors[t][2*i+1],chain.template get<Level>());seconds[j]=std::chrono::duration<double>(std::chrono::steady_clock::now()-then).count();}\n std::cout<<\"SPAN tree level=\"<<Level<<\" wall=\"<<std::chrono::duration<double>(std::chrono::steady_clock::now()-start).count()<<\" nodes=\"<<pairs.size()<<\" durations=\";for(auto x:seconds)std::cout<<x<<\",\";std::cout<<std::endl;\n factors.clear();diagnosticForest<Level+1>(results,std::move(next),chain);\n }\n}\n",
